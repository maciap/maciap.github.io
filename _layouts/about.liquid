---
layout: default
---
<div class="post">
  <header class="hero">
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="hero-photo">
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded-circle" sizes="230px" alt=page.profile.alt
          cache_bust=true
        %}
      </div>
    {% endif %}
    <div class="hero-text">
      <h1 class="hero-name">
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.middle_name }} <span class="font-weight-bold">{{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if page.subtitle %}
        <p class="hero-role">{{ page.subtitle }}</p>
      {% endif %}
      {% if page.profile.more_info %}
        <div class="hero-info">{{ page.profile.more_info }}</div>
      {% endif %}
    </div>
  </header>

  <article>
    <div class="clearfix about-content">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/blog/' | relative_url }}">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
